package fontconfig {
  version  = "2.17.1"
  summary  = "Font configuration and customization library"
  homepage = "https://www.freedesktop.org/wiki/Software/fontconfig/"
  license  = [HPND-sell-variant]

  source main {
    url    = ["https://gitlab.freedesktop.org/api/v4/projects/890/packages/generic/fontconfig/#{self.version}/fontconfig-#{self.version}.tar.xz"]
    sha256 = "sha256:6666666666666666666666666666666666666666666666666666666666666666"
  }

  build_deps = [meson, ninja, pkgconf, gperf]
  link_deps  = [freetype, expat]

  build meson {
    options = ["-Dcache-dir=/usr/lib/fontconfig/cache", "-Dcache-build=disabled",
               "-Ddoc=disabled", "-Dtests=enabled", "-Dtools=enabled"]
  }
}
