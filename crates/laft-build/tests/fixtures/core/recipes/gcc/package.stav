import "std/build" as build

package gcc {
  version  = "15.2.0"
  summary  = "The GNU Compiler Collection (C and C++)"
  homepage = "https://gcc.gnu.org"
  license  = [GPL-3.0-or-later, GCC-exception-3.1]
  split    = [dev, doc, dbg, locale]

  source main {
    url    = build.gnu_mirrors("gcc/gcc-#{self.version}/gcc-#{self.version}.tar.xz")
    sha256 = "sha256:5555555555555555555555555555555555555555555555555555555555555555"
  }

  build_deps = [perl, flex, bison, texinfo]
  link_deps  = [gmp, mpfr, libmpc, isl, zlib, zstd]

  build configure {
    out_of_tree   = true
    standard_args = false
    args = ["--prefix=/usr", "--libdir=/usr/lib", "--libexecdir=/usr/lib",
            "--mandir=/usr/share/man", "--infodir=/usr/share/info",
            "--build=x86_64-laft-linux-gnu", "--host=x86_64-laft-linux-gnu",
            "--enable-languages=c,c++,lto", "--enable-default-pie", "--enable-default-ssp",
            "--enable-host-pie", "--enable-linker-build-id", "--enable-plugin",
            "--enable-lto", "--disable-multilib", "--disable-bootstrap",
            "--disable-fixincludes", "--with-system-zlib", "--with-zstd"]
  }

  phases {
    post_install = """
      ln -s gcc "$DESTDIR/usr/bin/cc"
      ln -s g++ "$DESTDIR/usr/bin/c++"
      """
  }

  subpackage libs {
    summary = "GCC runtime libraries (libgcc_s, libstdc++, libatomic, libgomp)"
    files   = ["usr/lib/libgcc_s.so.*", "usr/lib/libstdc++.so.*", "usr/lib/libatomic.so.*",
               "usr/lib/libgomp.so.*", "usr/lib/libitm.so.*", "usr/lib/libquadmath.so.*",
               "usr/lib/libssp.so.*", "usr/share/gcc-*/python/**"]
    exclude = ["usr/lib/*.py"]
  }

  alternative cc {
    paths    = ["usr/bin/cc", "usr/bin/c++"]
    priority = 100
  }

  check = false
  ci { runner = big }
}
