import "std/build" as build

package ripgrep {
  version  = "14.1.1"
  summary  = "Recursively search directories for a regex pattern"
  homepage = "https://github.com/BurntSushi/ripgrep"
  license  = [MIT, Unlicense]
  variants = [dynamic, static]

  source main {
    url    = [build.github_archive("BurntSushi/ripgrep", self.version, "ripgrep")]
    sha256 = "sha256:4dad02a2f9c8c3c8d89434e47337aa654cb0e2aa50e806589132f186bf5c2b66"
  }
  vendor cargo { sha256 = "sha256:1111111111111111111111111111111111111111111111111111111111111111" }

  build_deps = [rust, pkgconf]
  link_deps  = [pcre2]

  build cargo {
    features = ["pcre2"]
    bins     = ["rg"]
  }

  phases {
    post_install = """
      install -d "$DESTDIR/usr/share/man/man1" \
                 "$DESTDIR/usr/share/bash-completion/completions" \
                 "$DESTDIR/usr/share/zsh/site-functions" \
                 "$DESTDIR/usr/share/fish/vendor_completions.d"
      "$CARGO_OUT/rg" --generate man > "$DESTDIR/usr/share/man/man1/rg.1"
      "$CARGO_OUT/rg" --generate complete-bash > "$DESTDIR/usr/share/bash-completion/completions/rg"
      "$CARGO_OUT/rg" --generate complete-zsh  > "$DESTDIR/usr/share/zsh/site-functions/_rg"
      "$CARGO_OUT/rg" --generate complete-fish > "$DESTDIR/usr/share/fish/vendor_completions.d/rg.fish"
      """
  }

  smoke = """
    printf 'needle\n' > /tmp/f
    rg --pcre2 'need(?=le)' /tmp/f
    """
  update { github = "BurntSushi/ripgrep" }
}
