### configure
#!/bin/sh
set -eu
umask 022
cd "$SRC"
"$SRC/configure" '--prefix=/usr' '--libdir=/usr/lib'
### build
#!/bin/sh
set -eu
umask 022
cd "$SRC"
make
### check
#!/bin/sh
set -eu
umask 022
cd "$SRC"
make 'check'
### install
#!/bin/sh
set -eu
umask 022
cd "$SRC"
make DESTDIR="$DESTDIR" install
