---
source: crates/laft-build/tests/examples.rs
assertion_line: 34
expression: scripts(&recipe)
---
### prepare
#!/usr/bin/bash
set -euo pipefail
umask 022
cd "$SRC/"
if false; then autoreconf -fi; fi
### configure
#!/usr/bin/bash
set -euo pipefail
umask 022
cd "$SRC/"
if false; then cd "$BUILDDIR"; fi
"$SRC//configure" '--prefix=/usr' '--libdir=/usr/lib' '--static'
### build
#!/usr/bin/bash
set -euo pipefail
umask 022
cd "$SRC/"
if false; then cd "$BUILDDIR"; fi
make
### check
#!/usr/bin/bash
set -euo pipefail
umask 022
cd "$SRC/"
if false; then cd "$BUILDDIR"; fi
make 'check'
### install
#!/usr/bin/bash
set -euo pipefail
umask 022
cd "$SRC/"
if false; then cd "$BUILDDIR"; fi
make DESTDIR="$DESTDIR" install
