=== services/runit/early-longruns (444)
udevd
=== services/runit/stage/1 (555)
#!/bin/sh
# Rendered by laft for generation 42. Early boot graph, in dependency order.
PATH=/usr/bin
export PATH
mkdir -p /run/runit/ready /run/runit/service /run/runit/early

/usr/bin/laft svc up --backend runit laft-activate
/usr/bin/laft svc up --backend runit kernel-fs
/usr/bin/laft svc exec --backend runit --background udevd
/usr/bin/laft svc up --backend runit clock
/usr/bin/laft svc up --backend runit hostname
/usr/bin/laft svc up --backend runit kmod
/usr/bin/laft svc up --backend runit udev-trigger
/usr/bin/laft svc up --backend runit console
/usr/bin/laft svc up --backend runit mount-fs
/usr/bin/laft svc up --backend runit random-seed
/usr/bin/laft svc up --backend runit swap
/usr/bin/laft svc up --backend runit sysctl
/usr/bin/laft svc up --backend runit early
exit 0
=== services/runit/stage/2 (555)
#!/bin/sh
PATH=/usr/bin
export PATH
cp -a /run/laft/system/services/runit/sv/. /run/runit/service/
exec env - PATH=/usr/bin runsvdir -P /run/runit/service 'log: ...........................................................................................................................................'
=== services/runit/stage/3 (555)
#!/bin/sh
PATH=/usr/bin
export PATH
sv -w 10 force-stop /run/runit/service/*
sv exit /run/runit/service/*
# Stop early longruns started in stage 1.
/usr/bin/laft svc stop-early --backend runit
# Early oneshots with a down command, in reverse order.
/usr/bin/laft svc down --backend runit swap
/usr/bin/laft svc down --backend runit random-seed
/usr/bin/laft svc down --backend runit mount-fs
/usr/bin/laft svc down --backend runit clock
kill -s TERM -1
sleep 2
kill -s KILL -1
sync
mount -o remount,ro /
