exec /usr/bin/laft svc exec --backend runit loud
=== services/runit/sv/quiet/finish (555)
#!/bin/sh
exec /usr/bin/laft svc finish --backend runit quiet "$1" "$2"
=== services/runit/sv/quiet/run (555)
