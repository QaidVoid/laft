{
  "boot-complete": {
    "description": "Mark the boot as good",
    "kind": "oneshot",
    "enable": true,
    "exec": [],
    "up": [
      "/usr/bin/laft",
      "boot",
      "mark-good"
    ],
    "down": [],
    "user": "root",
    "group": null,
    "groups": [],
    "env": {},
    "cwd": "/",
    "umask": 18,
    "after": [],
    "ready": "immediate",
    "log": "logged",
    "rotate": {
      "size": 1000000,
      "count": 10
    },
    "state_dirs": [],
    "runtime_dirs": [],
    "restart": "always",
    "restart_delay": 1,
    "stop_signal": "TERM",
    "stop_timeout": 10,
    "limits": {
      "nofile": null,
      "nproc": null,
      "core": null,
      "memlock": null
    },
    "on_change": "ignore",
    "early": false,
    "packages": []
  },
