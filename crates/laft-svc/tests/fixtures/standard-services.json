  "udevd": {
    "description": "Device manager",
    "kind": "longrun",
    "enable": true,
    "exec": [
      "/usr/bin/udevd"
    ],
    "up": [],
    "down": [],
    "user": "root",
    "group": null,
    "groups": [],
    "env": {},
    "cwd": "/",
    "umask": 18,
    "after": [
      "kernel-fs"
    ],
    "ready": {
      "check": {
        "cmd": [
          "/usr/bin/udevadm",
          "control",
          "--ping"
        ],
        "interval": 1,
        "timeout": 60
      }
    },
    "log": "console",
    "rotate": {
      "size": 1000000,
      "count": 10
    },
