package busybox {
  version  = "1.37.0"
  summary  = "Common UNIX utilities in one static program"
  homepage = "https://busybox.net"
  license  = [GPL-2.0-only]
  variants = [static]

  source main {
    url    = ["https://busybox.net/downloads/busybox-#{self.version}.tar.bz2"]
    sha256 = "sha256:3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4"
  }

  build custom {}
  static_pie = false
  strip      = false
  split      = []

  phases {
    # The shadow parser keeps a stale errno when every aging field of an
    # entry is empty, which shadow(5) allows, and then rejects the entry.
    # runit ships its own chpst, runsv, runsvdir, sv and svlogd, and tc
    # does not build against current kernel headers.
    configure = """
      sed -i 's/^\tmemset(result, 0, db->size_of);$/&\n\terrno = 0;/' libpwdgrp/pwd_grp.c
      grep -q '^.errno = 0;$' libpwdgrp/pwd_grp.c
      make defconfig
      sed -i \
        -e 's/^# CONFIG_STATIC is not set$/CONFIG_STATIC=y/' \
        -e 's/^CONFIG_MODPROBE_SMALL=y$/# CONFIG_MODPROBE_SMALL is not set/' \
        -e 's/^CONFIG_TC=y$/# CONFIG_TC is not set/' \
        -e 's/^CONFIG_\(CHPST\|ENVDIR\|ENVUIDGID\|RUNSV\|RUNSVDIR\|SETUIDGID\|SOFTLIMIT\|SV\|SVC\|SVLOGD\|SVOK\)=y$/# CONFIG_\1 is not set/' \
        .config
      { yes '' || :; } | make oldconfig >/dev/null
      """
    build = """
      make CROSS_COMPILE="$CHOST-" HOSTCC=gcc -j"$JOBS" busybox
      """
    # agetty is what the getty services run. busybox getty takes the same
    # arguments except --noclear, and -L stands in for the automatic
    # carrier detection of agetty on serial lines.
    install = """
      install -Dm755 busybox "$DESTDIR/usr/bin/busybox"
      for applet in $(./busybox --list); do
        ln -s busybox "$DESTDIR/usr/bin/$applet"
      done
      printf '%s\n' '#!/usr/bin/sh' '[ "$1" = --noclear ] && shift' 'exec /usr/bin/getty -L "$@"' \
        > "$DESTDIR/usr/bin/agetty"
      chmod 755 "$DESTDIR/usr/bin/agetty"
      """
  }
}
