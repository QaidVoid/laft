package runit {
  version  = "2.3.1"
  summary  = "A UNIX init scheme with service supervision"
  homepage = "https://smarden.org/runit/"
  license  = [BSD-3-Clause]
  variants = [static]

  source main {
    url    = ["https://smarden.org/runit/runit-#{self.version}.tar.gz"]
    sha256 = "sha256:634f23c8c4d1d440043be0fe928ddf904626289e97bfe7c5826e93aaf2cc6fe9"
  }

  build custom {}
  static_pie    = false
  strip         = false
  split         = []
  license_files = ["runit-2.3.1/package/COPYING"]

  phases {
    subdir    = "runit-2.3.1/src"
    configure = """
      echo "$CC $CFLAGS" > conf-cc
      echo "$CC $LDFLAGS" > conf-ld
      """
    build = """
      make
      """
    install = """
      for program in $(cat ../package/commands); do
        install -Dm755 "$program" "$DESTDIR/usr/bin/$program"
      done
      """
  }
}
